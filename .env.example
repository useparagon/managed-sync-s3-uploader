PARAGON_BASE_URL=https://sync.useparagon.com
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1
PORT=3000
WEBHOOK_SECRET=your_webhook_secret_optional

# Persistence configuration
# Use "s3" for container deployments (recommended) or "file" for volume-mounted storage
PERSISTENCE_MODE=s3
# S3 key for storing state (only used when PERSISTENCE_MODE=s3)
PERSISTENCE_S3_KEY=.sync-state/processed-records.json
# File path for storing state (only used when PERSISTENCE_MODE=file)
# Use /app/data/ for Docker volume mounts
PERSISTENCE_FILE_PATH=/app/data/.processed-records.json

PARAGON_PROJECT_ID=""
PARAGON_SIGNING_KEY=""